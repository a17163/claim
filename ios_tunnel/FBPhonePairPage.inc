#import "RouteRequest.h"
#import "RouteResponse.h"
#import "FBPairEvents.inc"

static NSString *FBPhonePairNonce;
static NSTimeInterval FBPhonePairNonceAt;
static NSString *FBPhonePairReceipt;
static NSString *FBPhonePairState;
static const NSTimeInterval FBPhonePairWait = 45;
static NSTimeInterval FBPhonePairStarted;
static NSString *const FBPhonePairPath = @"/wda/claim/pairing";

static void FBPhonePairPage(RouteRequest *request, RouteResponse *response, BOOL submit)
{
  NSURL *plugins = NSBundle.mainBundle.builtInPlugInsURL;
  NSURL *path = [[plugins URLByAppendingPathComponent:@"WebDriverAgentRunner.xctest"]
                 URLByAppendingPathComponent:@"FBRemoteTunnel.plist"];
  NSDictionary *config = path ? [NSDictionary dictionaryWithContentsOfURL:path] : nil;
  [response setHeader:@"Cache-Control" value:@"no-store"];
  // Keep Safari's same-origin form Origin header; the loopback guard rejects Origin: null.
  [response setHeader:@"Referrer-Policy" value:@"same-origin"];
  [response setHeader:@"Content-Type" value:@"text/html; charset=utf-8"];
  [response setHeader:@"X-Content-Type-Options" value:@"nosniff"];
  [response setHeader:@"Content-Security-Policy" value:@"default-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"];
  if (![config[@"Enabled"] boolValue] || ![config[@"EnrollmentOrigin"] isKindOfClass:NSString.class]) {
    response.statusCode = kHTTPStatusCodeNotFound;
    [response respondWithString:@"此 WDA 未启用手机配对。请使用配对版安装包。"];
    return;
  }

  NSTimeInterval now = NSProcessInfo.processInfo.systemUptime;
  static dispatch_once_t onceToken;
  dispatch_once(&onceToken, ^{
    [NSNotificationCenter.defaultCenter addObserverForName:FBPairResultEvent object:nil queue:nil
        usingBlock:^(NSNotification *event) {
      dispatch_async(dispatch_get_main_queue(), ^{
        if ([FBPhonePairReceipt isEqualToString:event.userInfo[@"receipt"]]) {
          FBPhonePairState = event.userInfo[@"state"];
        }
      });
    }];
  });

  NSString *message = @"请在网页控制台生成配对码，再用这台 iPhone 扫码或手动输入。";
  NSString *state = nil;
  NSString *receipt = nil;
  if (submit) {
    NSMutableDictionary *fields = [NSMutableDictionary dictionary];
    if (request.body.length <= 256) {
      NSString *body = [[NSString alloc] initWithData:request.body encoding:NSUTF8StringEncoding];
      NSURLComponents *encoded = [NSURLComponents new];
      if (body && [body rangeOfString:@"\\A[A-Za-z0-9_&=-]+\\z" options:NSRegularExpressionSearch].location != NSNotFound) {
        encoded.percentEncodedQuery = body;
        for (NSURLQueryItem *item in encoded.queryItems) {
          if (item.value) fields[item.name] = item.value;
        }
      }
    }
    NSString *code = fields[@"code"];
    if (FBPhoneClaimBusy()) {
      message = @"请先停止这台手机上的领取任务，再绑定。";
    } else if (!FBPhonePairNonce || now - FBPhonePairNonceAt > 600 || ![fields[@"nonce"] isEqual:FBPhonePairNonce] ||
               !code || [code rangeOfString:@"\\A[A-Za-z0-9_-]{24}\\z" options:NSRegularExpressionSearch].location == NSNotFound) {
      message = @"配对码格式有误或页面已过期，请重新扫码或输入。";
    } else if ([FBPhonePairState isEqualToString:@"pending"] && now - FBPhonePairStarted <= FBPhonePairWait) {
      receipt = FBPhonePairReceipt;
    } else {
      receipt = FBPhonePairReceipt = NSUUID.UUID.UUIDString;
      FBPhonePairStarted = now;
      FBPhonePairState = @"pending";
      [NSNotificationCenter.defaultCenter postNotificationName:FBPairRequestEvent object:nil
          userInfo:@{@"code": code, @"receipt": receipt}];
    }
    if (receipt) {
      response.statusCode = kHTTPStatusCodeSeeOther;
      [response setHeader:@"Location" value:[NSString stringWithFormat:@"%@?receipt=%@", FBPhonePairPath, receipt]];
      [response respondWithString:@""];
      return;
    }
  } else if (request.params[@"receipt"] != nil) {
    // Only echo a receipt that was generated by WDA.
    if ([FBPhonePairReceipt isEqualToString:request.params[@"receipt"]]) {
      receipt = FBPhonePairReceipt;
      state = FBPhonePairState;
    }
    if (!state || ([state isEqualToString:@"pending"] && now - FBPhonePairStarted > FBPhonePairWait)) state = @"expired";
    message = @{
      @"pending": @"正在绑定，请保持 WDA 运行。",
      @"success": @"绑定成功，可以返回网页控制台。",
      @"rejected": @"配对码无效、已过期或已使用，请生成新码后重试。",
      @"key": @"无法保存手机绑定凭据，请保持解锁后重试。",
      @"busy": @"当前无法开始绑定，请先停止领取或稍后重试。",
      @"network": @"无法确认服务器响应，请检查网络或先到网页查看设备列表。",
      @"expired": @"暂未收到绑定结果，请先到网页查看设备列表。",
    }[state] ?: @"无法确认绑定结果，请先到网页查看设备列表。";
  }

  BOOL pending = [state isEqualToString:@"pending"];
  BOOL success = [state isEqualToString:@"success"];
  NSString *refresh = pending ? [NSString stringWithFormat:
    @"<meta http-equiv=refresh content='1;url=%@?receipt=%@'>", FBPhonePairPath, receipt] : @"";
  NSString *result = success ? [NSString stringWithFormat:
    @"<div class=overlay><dialog open aria-modal=true aria-labelledby=success-title><h2 id=success-title>绑定成功</h2>"
     "<p>这台 iPhone 已登记，可以返回网页控制台查看设备。</p><a class=confirm href='%@' autofocus>知道了</a></dialog></div>",
     FBPhonePairPath] : @"";
  FBPhonePairNonce = NSUUID.UUID.UUIDString;
  FBPhonePairNonceAt = now;
  [response setHeader:@"Content-Security-Policy" value:[NSString stringWithFormat:
    @"default-src 'none'; script-src 'nonce-%@'; style-src 'nonce-%@'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
    FBPhonePairNonce, FBPhonePairNonce]];
  NSString *html = [NSString stringWithFormat:
    @"<!doctype html><html lang=zh-CN><meta charset=utf-8><meta name=viewport content='width=device-width, initial-scale=1'>"
    "<meta name=theme-color content='#edf5f0'><title>绑定 iPhone · WDA Remote</title>%@"
    "<style nonce='%@'>"
    "*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;"
      "background:radial-gradient(ellipse at 20%% 0,#dcefe6,#f4f7f5 70%%);color:#18342a;font:16px/1.55 -apple-system,system-ui,sans-serif}"
    "main,dialog{width:min(100%%,420px);background:#fff;border:1px solid #d9e8df;border-radius:26px;padding:28px;"
    "box-shadow:0 18px 50px #173d2722}main{max-width:100%%}"
    ".overlay{position:fixed;inset:0;display:grid;place-items:center;padding:24px;background:#102b2377}"
    "dialog[open]{display:block;position:static;margin:0;color:#18342a}"
    ".mark{display:grid;place-items:center;width:52px;height:52px;border-radius:16px;background:#dff2e8;color:#175b42}"
    ".tag{margin:18px 0 3px;color:#286d54;font-size:13px;font-weight:700;letter-spacing:.11em}"
    "h1,h2{margin:0;font-size:28px;line-height:1.25}h2{font-size:23px}p{margin:10px 0 18px;color:#4d6258}"
    "label{display:block;font-weight:650}input,button,.confirm{width:100%%;font:inherit;border-radius:12px;padding:12px 14px}"
    "input{margin-top:6px;border:1px solid #a9c3b4;color:#18342a;background:#f7faf8}"
    "button,.confirm{margin-top:16px;border:0;background:#18654a;color:#fff;font-weight:700;cursor:pointer}"
    ".confirm{display:block;text-align:center;text-decoration:none}"
    "button:disabled{opacity:.55;cursor:default}input:focus-visible,button:focus-visible{outline:3px solid #3d896c;outline-offset:3px}"
    ".note{font-size:13px;margin:14px 0 0}.error{color:#932f29}"
    "</style><main %@>"
    "<div class=mark aria-hidden=true><svg width=26 height=26 viewBox='0 0 24 24' fill=none stroke=currentColor stroke-width=1.8>"
    "<rect x=6 y=2.5 width=12 height=19 rx=3/><path d='M10 18h4'/></svg></div>"
    "<div class=tag>WDA REMOTE</div><h1>绑定这台 iPhone</h1><p class='%@' role=status>%@</p>"
    "<form method=post action='%@' %@><input type=hidden name=nonce value='%@'>"
    "<label>配对码<input id=pair-code name=code type=password placeholder='输入 24 位配对码' autocapitalize=off autocorrect=off "
    "spellcheck=false autocomplete=off minlength=24 maxlength=24 pattern='[A-Za-z0-9_\\-]{24}' required></label>"
    "<button id=bind type=submit>绑定</button></form>"
    "<p class=note>配对码 10 分钟有效。请勿在这里输入钱包密码。</p></main>%@"
    "<script nonce='%@'>"
    "(()=>{const input=document.getElementById('pair-code'),button=document.getElementById('bind');"
    "const code=new URLSearchParams(location.hash.slice(1)).get('code');"
    "if(/^[A-Za-z0-9_-]{24}$/.test(code||''))input.value=code;"
    "if(location.hash)history.replaceState(null,'',location.pathname);"
    "button.form.addEventListener('submit',()=>{button.disabled=true;button.textContent='正在绑定…';});"
    "})();"
    "</script></html>",
    refresh, FBPhonePairNonce, success ? @"hidden" : @"", state && !pending && !success ? @"error" : @"",
    message, FBPhonePairPath, pending ? @"hidden" : @"", FBPhonePairNonce, result, FBPhonePairNonce];
  [response respondWithString:html];
}
